# Build or load this image before starting the unit; it never pulls on startup.
# For deployments, use an immutable tag or repository@sha256:digest.
FFMPEG_AGENT_IMAGE=ffmpeg-agent:local
FFMPEG_AGENT_LISTEN=0.0.0.0:8080

# JWT authentication (required). The unit mounts the directory /etc/ffmpeg-agent/auth
# read-only at /run/ffmpeg-agent/auth; replace jwks.json there to rotate keys.
FFMPEG_AGENT_AUTH_JWKS_FILE=/run/ffmpeg-agent/auth/jwks.json
# The value your token issuer puts in "aud" for this agent.
FFMPEG_AGENT_AUTH_AUDIENCE=ffmpeg-agent
# Optional: uncomment to require these as well.
#FFMPEG_AGENT_AUTH_ISSUER=example-issuer
#FFMPEG_AGENT_AUTH_TYP=JWT
#FFMPEG_AGENT_AUTH_SUBJECTS=example-caller
FFMPEG_AGENT_AUTH_MAX_LIFETIME_SECS=300

FFMPEG_AGENT_WORK_DIR=/work
FFMPEG_AGENT_CONCURRENCY=1
FFMPEG_AGENT_QUEUE_CAPACITY=1
FFMPEG_AGENT_HEARTBEAT_SECS=10
FFMPEG_AGENT_STALL_TIMEOUT_SECS=120
FFMPEG_AGENT_JOB_TIMEOUT_SECS=0
FFMPEG_AGENT_MAX_INPUT_BYTES=17179869184
FFMPEG_AGENT_MAX_OUTPUT_BYTES=17179869184
